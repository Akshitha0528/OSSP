#include <stdio.h>
#include <string.h>

#define MAX_TOKENS 50
#define MAX_TOKEN_SIZE 100

int parse_command(char *input, char tokens[MAX_TOKENS][MAX_TOKEN_SIZE])
{
    int token_count = 0;
    int i = 0;
    int j = 0;
    int in_single = 0;
    int in_double = 0;
    int escape = 0;

    while (input[i] != '\0')
    {
        char c = input[i];

        if (escape)
        {
            tokens[token_count][j++] = c;
            escape = 0;
        }
        else if (c == '\\')
        {
            escape = 1;
        }
        else if (c == '\'' && !in_double)
        {
            in_single = !in_single;
        }
        else if (c == '"' && !in_single)
        {
            in_double = !in_double;
        }
        else if (c == ' ' && !in_single && !in_double)
        {
            if (j > 0)
            {
                tokens[token_count][j] = '\0';
                token_count++;
                j = 0;
            }
        }
        else
        {
            tokens[token_count][j++] = c;
        }

        i++;
    }

    if (escape || in_single || in_double)
    {
        printf("Error: Invalid or incomplete escape/quote sequence.\n");
        return -1;
    }

    if (j > 0)
    {
        tokens[token_count][j] = '\0';
        token_count++;
    }

    return token_count;
}

int main()
{
    char input[500];
    char tokens[MAX_TOKENS][MAX_TOKEN_SIZE];

    printf("Enter command: ");
    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    int count = parse_command(input, tokens);

    if (count == -1)
        return 1;

    printf("\nParsed tokens:\n");

    for (int i = 0; i < count; i++)
        printf("Token %d: [%s]\n", i + 1, tokens[i]);

    printf("\nTotal tokens: %d\n", count);

    return 0;
}
