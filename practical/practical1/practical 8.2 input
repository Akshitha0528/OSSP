#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

void show_memory()
{
    char command[100];
    sprintf(command, "grep -E 'VmSize|VmRSS' /proc/%d/status", getpid());
    system(command);
}

int main()
{
    int *data = malloc(5 * sizeof(int));

    for (int i = 0; i < 5; i++)
        data[i] = i + 1;

    printf("Before fork:\n");
    printf("Address of data: %p\n", (void *)data);
    printf("Data: ");

    for (int i = 0; i < 5; i++)
        printf("%d ", data[i]);

    printf("\n\n");

    pid_t pid = fork();

    if (pid < 0)
    {
        perror("fork failed");
        free(data);
        return 1;
    }

    if (pid == 0)
    {
        printf("Child process before modification:\n");
        show_memory();

        printf("Data before modification: ");
        for (int i = 0; i < 5; i++)
            printf("%d ", data[i]);

        printf("\n\n");

        data[0] = 100;

        printf("Child process after modification:\n");
        show_memory();

        printf("Data after modification: ");
        for (int i = 0; i < 5; i++)
            printf("%d ", data[i]);

        printf("\n");

        free(data);
        exit(0);
    }
    else
    {
        wait(NULL);

        printf("\nParent process:\n");
        show_memory();

        printf("Parent data: ");
        for (int i = 0; i < 5; i++)
            printf("%d ", data[i]);

        printf("\n");

        free(data);
    }

    return 0;
}
